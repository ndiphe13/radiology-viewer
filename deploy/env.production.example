#--------------------------------------------------------------------
# Copy to /var/www/radiology-viewer/.env and fill in the values.
# chown root:www-data .env && chmod 640 .env
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# Local time for report dates and link expiry
app.appTimezone = 'Asia/Jakarta'

app.baseURL   = 'https://radiology.example.local/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

database.default.hostname = 127.0.0.1
database.default.database = radiology_viewer
database.default.username = radiology_app
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.port     = 3306

cookie.secure   = true
cookie.httponly = true

# DICOM preview (see app/Config/Dicom.php for all options)
# Windows path prefix is set in app/Config/Dicom.php (a trailing backslash breaks .env)
dicom.basePath      = /mnt/radiology-images
dicom.converter     = /usr/bin/dcmj2pnm
